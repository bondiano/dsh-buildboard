{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": ".",
		"types": ["node"],
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"noEmitOnError": true,
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"]
	},
	"include": ["*.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
