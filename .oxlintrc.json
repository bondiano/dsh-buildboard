{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"node": true,
		"es2023": true
	},
	"options": {
		"typeAware": true
	},
	"rules": {
		"typescript/no-floating-promises": [
			"error",
			{
				"checkThenables": true
			}
		],
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/switch-exhaustiveness-check": "error",
		"eslint/no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrors": "none"
			}
		]
	},
	"ignorePatterns": ["node_modules/**", "dist/**", "lib/**"],
	"overrides": [
		{
			"files": ["test/**/*.ts"],
			"rules": {
				"typescript/no-floating-promises": [
					"error",
					{
						"checkThenables": true,
						"allowForKnownSafeCalls": [
							{
								"from": "package",
								"name": "test",
								"package": "node:test"
							},
							{
								"from": "package",
								"name": "describe",
								"package": "node:test"
							},
							{
								"from": "package",
								"name": "it",
								"package": "node:test"
							},
							{
								"from": "package",
								"name": "suite",
								"package": "node:test"
							}
						]
					}
				]
			}
		},
		{
			"files": ["client.ts", "src/presentation/client.ts", "types/client.d.ts"],
			"env": {
				"browser": true
			}
		}
	]
}
