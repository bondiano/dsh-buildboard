{
	"name": "@local/dsh-buildboard",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Heptabase-style whiteboard for DeepSeek Harness: cards, documents, agent research and implementation workflows on tldraw + xstate.",
	"exports": {
		".": "./dist/index.js",
		"./client": "./lib/client.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"files": [
		"dist",
		"lib",
		"cordis.patch.yml",
		"locale/*.json",
		"docs",
		"README.md",
		"README.ru.md",
		"icon.svg",
		"LICENSE"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-api-remotes",
				"@deepseek-ai/dsh-client-connection",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-layout",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-sidebar-right",
				"@deepseek-ai/dsh-client-ui-workspace"
			]
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bondiano/dsh-buildboard.git"
	},
	"homepage": "https://github.com/bondiano/dsh-buildboard#readme",
	"bugs": {
		"url": "https://github.com/bondiano/dsh-buildboard/issues"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test dist/test/unit/*.test.js",
		"test:e2e": "playwright test",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix --deny-warnings .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:client && npm run test:e2e",
		"build:client": "tsdown"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "4.1.0",
		"@playwright/test": "1.58.2",
		"@types/node": "22.18.6",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"tsdown": "0.23.7",
		"typescript": "5.9.2"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "3.19.0",
		"tldraw": "3.15.1",
		"xstate": "5.33.4"
	}
}
